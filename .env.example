# TaskSphere Environment Configuration
# Copy this file to .env and fill in your values

# MySQL Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=tasksphere
DB_PORT=3306

# JWT Authentication
# IMPORTANT: Replace with a strong, unique secret in production
JWT_SECRET=replace_with_a_strong_random_secret_key
JWT_EXPIRY=7d

# Server
PORT=5000
NODE_ENV=development

# Frontend Origin (must match Vite dev server port)
CLIENT_ORIGIN=http://localhost:3000
