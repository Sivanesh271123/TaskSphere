# TaskSphere Environment Configuration
# Copy this file to .env and fill in your values

# MySQL Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=tasksphere
DB_PORT=3306

# JWT Authentication
# IMPORTANT: Replace with a strong, unique secret in production
JWT_SECRET=replace_with_a_strong_random_secret_key
JWT_EXPIRY=7d

# Server
PORT=5000
NODE_ENV=development

# Frontend Origin (must match Vite dev server port)
CLIENT_ORIGIN=http://localhost:3000

# Resend Email Configuration (Password Reset OTPs & Notifications)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev

# Firebase Cloud Messaging Config
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_VAPID_KEY=your_vapid_key_here
